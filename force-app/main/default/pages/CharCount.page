        function countCharacters(content) {
            // Remove HTML tags using a regular expression
            var cleanContent = content.replace(/<\/?[^>]+(>|$)/g, "");

            // Count characters in the cleaned content
            return cleanContent.length;
        }

        function countWords(content) {
            // Remove HTML tags using a regular expression
            var cleanContent = content.replace(/<\/?[^>]+(>|$)/g, "");

            // Remove leading/trailing whitespace and split into words
            var words = cleanContent.trim().split(/\s+/);

            // Count words
            return words.length;
        }

        // Call the function when the window loads
        window.onload = countCharactersAndWords;
    </script>
